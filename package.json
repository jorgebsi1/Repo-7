{
  "name": "prolac",
  "private": true,
  "version": "0.1.0",
  "description": "Prolac — venta en línea de lácteos (esqueleto). Ver docs/.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r --filter './packages/*' build && pnpm -r typecheck",
    "test": "pnpm -r --filter './packages/*' build && pnpm -r test",
    "dev": "pnpm -r --filter './packages/*' build && pnpm -r --parallel --filter './apps/*' dev",
    "seed": "pnpm --filter @prolac/api seed",
    "import:catalog": "pnpm --filter @prolac/api import:catalog"
  }
}
